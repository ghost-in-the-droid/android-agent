{
  "version": "v1.1",
  "effective_from": "2026-10-20",
  "description": "Skill Hub quality ladder. Single source of truth for tools/quality.py and the site /skills/scoring page. Points are 0 to 100: the category caps sum to max_points. v1.1 (pre-launch, 2026-10-20): validators are scored per action (the weakest action counts, kind weights below) and self_evidence gains a self-reliability signal (Wilson lower bound over the author's own verified runs). After launch, values change only at season boundaries with 30 days notice.",
  "max_points": 100,
  "tiers": [
    {
      "id": "draft",
      "points": 0
    },
    {
      "id": "runs",
      "points": 10
    },
    {
      "id": "proven",
      "points": 35
    },
    {
      "id": "hardened",
      "points": 65
    },
    {
      "id": "reference",
      "points": 90
    }
  ],
  "categories": {
    "docs": {
      "cap": 15,
      "items": {
        "manifest": 3,
        "readme": 3,
        "failure_modes": 4,
        "demo_any": 3,
        "demo_all_actions": 2
      }
    },
    "self_evidence": {
      "cap": 15,
      "items": {
        "first_self_run": 3,
        "validators": {
          "each": 2,
          "cap": 6,
          "per": "action",
          "weights": {
            "custom_python": 2,
            "parameterised_text": 2,
            "default": 1
          }
        },
        "bench_one_model": 2,
        "self_reliability": {
          "cap": 4,
          "min_runs": 10
        }
      }
    },
    "independent": {
      "cap": 40,
      "items": {
        "first_independent": 12,
        "second_device_class": 10,
        "third_device_class": 6,
        "bench_second_model": 8,
        "bench_third_model": 4
      }
    },
    "community_usage": {
      "cap": 20,
      "wilson_z": 1.96,
      "min_runs": 10,
      "window_days": 90
    },
    "maintenance": {
      "cap": 10,
      "reverified_within_days": 30,
      "bug_response_within_days": 7,
      "items": {
        "reverified_30d": 6,
        "bug_response_7d": {
          "each": 2,
          "cap": 4
        }
      }
    }
  },
  "freshness": {
    "steps": [
      {
        "max_days": 90,
        "multiplier": 1.0
      },
      {
        "max_days": 180,
        "multiplier": 0.8
      }
    ],
    "floor": 0.5
  },
  "provisional_days": 7,
  "gates": {
    "proven_min_validators": 3,
    "hardened_min_oem_combos": 2,
    "hardened_min_bench_models": 2,
    "hardened_min_community_runs": 10,
    "hardened_min_wilson_lb": 0.8,
    "hardened_max_days_since_verified": 90,
    "reference_min_hardened_days": 60
  }
}
