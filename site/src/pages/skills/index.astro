---
// /skills/ hub browser, generated from skillhub/registry.json at build time.
import HubLayout from '../../layouts/HubLayout.astro';
import AppIcon from '../../components/hub/AppIcon.astro';
import { loadHub } from '../../lib/hub/registry';
import { TIERS, MAX_POINTS } from '../../lib/hub/scoring';

const hub = loadHub();
const blockedCount = hub.skills.filter((s) => s.blocked && !s.reference).length;
// Benchmark reference skills (AndroidWorld scaffolds) are hidden until toggled: they are
// generated from benchmark tasks and have no authored steps or users yet.
const referenceCount = hub.skills.filter((s) => s.reference).length;
const hiddenByDefault = (s: typeof hub.skills[number]) => s.blocked || s.reference;
const shownCount = hub.skills.filter((s) => !hiddenByDefault(s)).length;
const shownSkills = hub.skills.filter((s) => !hiddenByDefault(s));
const apps = new Set(shownSkills.map((s) => s.latestEntry.fingerprint.app_package).filter(Boolean));
const authorCount = new Set(shownSkills.map((s) => s.author)).size;
let rank = 0;
---
<HubLayout
	title="Skill Hub: phone automations you can install | Ghost in the Droid"
	description="Find a phone automation. Compare actions, verified runs and quality scores, then inspect the evidence."
	current="browse"
>
	<section class="page-head browse-head">
		<h1>Skill Hub</h1>
		<p>
			{shownCount} {shownCount === 1 ? 'skill' : 'skills'} for {apps.size} {apps.size === 1 ? 'app' : 'apps'} from {authorCount} {authorCount === 1 ? 'author' : 'authors'}. Find an action. Check the evidence. Put it to work.
		</p>
	</section>
	<p class="showcase-link"><a class="inline-link" href="/skills/showcase/">Before / after showcase: compare per-action benchmark evidence →</a></p>

	<div class="toolbar" role="search">
		<label class="search">
			<span class="sr-only">Search skills</span>
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
			<input id="q" type="search" placeholder="Search skills or actions…" autocomplete="off" />
		</label>
		<label><span class="sr-only">Minimum quality tier</span>
			<select id="f-tier">
				<option value="0">Any tier</option>
				{TIERS.slice(1).map((t, i) => <option value={i + 1}>{t.label} or better</option>)}
			</select>
		</label>
		<label><span class="sr-only">Trust</span>
			<select id="f-trust">
				<option value="">Any trust</option>
				<option value="official">Official</option>
				<option value="verified">Verified</option>
				<option value="benchmark">Benchmark</option>
				<option value="unverified">Unverified</option>
			</select>
		</label>
		<label><span class="sr-only">Skill class</span>
			<select id="f-class">
				<option value="">Hard and soft</option>
				<option value="hard">Hard only</option>
				<option value="soft">Soft only</option>
			</select>
		</label>
		{blockedCount > 0 && (
			<label class="toggle" title="Blocked skills cannot complete on their own right now">
				<input id="f-blocked" type="checkbox" /> Show blocked ({blockedCount})
			</label>
		)}
		{referenceCount > 0 && (
			<label class="toggle" title="Reference skills are generated from benchmark tasks (AndroidWorld) and have no authored steps yet">
				<input id="f-reference" type="checkbox" /> Show benchmark reference skills ({referenceCount})
			</label>
		)}
		<span class="count" id="count" aria-live="polite">{shownCount} {shownCount === 1 ? 'skill' : 'skills'}</span>
	</div>

	<table class="browse-table">
		<caption class="sr-only">Skills. Use the column header buttons to sort.</caption>
		<thead>
			<tr>
				<th class="c-rank num" scope="col"><span aria-label="Rank">#</span></th>
				<th class="c-name" scope="col" aria-sort="none"><button type="button" data-sort="name">Skill<i class="arrow" aria-hidden="true"></i></button></th>
				<th class="c-desc" scope="col">Description</th>
				<th class="c-savings num" scope="col" aria-sort="none"><button type="button" data-sort="savings" title="Tokens without the skill divided by tokens with it, on the same phone and prompt (before / after recording).">Token savings<i class="arrow" aria-hidden="true"></i></button></th>
				<th class="c-score num" scope="col" aria-sort="none"><button type="button" data-sort="score">Score<i class="arrow" aria-hidden="true"></i></button></th>
			</tr>
		</thead>
		<tbody id="rows">
		{hub.skills.map((s, i) => (
			<tr
				class="row browse-row"
				data-url={`/skills/${s.author}/${s.slug}/`}
				data-score={s.points}
				data-tier={s.tierIndex}
				data-trust={s.trust}
				data-class={s.skill_class}
				data-blocked={s.blocked ? '1' : '0'}
				data-reference={s.reference ? '1' : '0'}
				data-stale={s.staleUpstream ? '1' : '0'}
				hidden={hiddenByDefault(s)}
				data-name={s.id}
				data-actions={s.latestEntry.actions.length}
				data-runs={s.runs.total}
				data-savings={s.beforeAfter?.metrics && s.beforeAfter.metrics.after.tokens > 0 ? s.beforeAfter.metrics.before.tokens / s.beforeAfter.metrics.after.tokens : 0}
				data-order={i}
				data-before-after={s.beforeAfter ? '1' : undefined}
				data-text={[s.id, s.description, s.latestEntry.fingerprint.app_package, ...s.latestEntry.actions, ...(s.beforeAfter ? ['before after'] : [])].join(' ').toLowerCase()}
			>
				<td class="c-rank num" data-rank>{hiddenByDefault(s) ? '' : ++rank}</td>
				<td class="c-name">
					<a class="ref skill-identity" href={`/skills/${s.author}/${s.slug}/`} title={`${s.id} — ${s.description}`}>
						<AppIcon skill={s} size={32} decorative />
						<span class="skill-name"><span class="a">{s.author}/</span><span class="s">{s.slug}</span></span>
						{(s.trust === 'official' || s.trust === 'verified') && <span class="trust-tick" data-trust={s.trust} role="img" aria-label={s.trust === 'official' ? 'Official author' : 'Verified author'} title={s.trust === 'official' ? 'Official author' : 'Verified author'}><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="currentColor" opacity=".15"/><path d="m4.5 8 2.3 2.3 4.7-4.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>}
					</a>
				</td>
				<td class="c-desc"><span class="desc" title={s.description}>{s.description}</span></td>
				<td class="c-savings num">{s.beforeAfter?.summary ? <a class="savings" data-before-after-badge href={`/skills/${s.author}/${s.slug}/`} data-fewer={s.beforeAfter.summary.tokensFewer ? '1' : '0'} title={`Before / after recording: ${s.beforeAfter.summary.headline} with the skill`}>{s.beforeAfter.summary.tokens.replace(/ tokens$/, '')}</a> : <span class="none" aria-label="Not measured yet">-</span>}</td>
				<td class="c-score num"><span data-skill-score>{s.points}<span class="score-denominator">/{MAX_POINTS}</span></span></td>
			</tr>
		))}
		</tbody>
	</table>
	<div class="empty" id="empty" hidden>
		<strong>No skill matches these filters.</strong>
		Clear the search or lower the tier filter. If the app you need is missing, <a class="inline-link" href="/skills/creating-skills/">write the skill</a> and it will show up here once merged.
	</div>
	<p class="prose-p" style="margin-top:2rem">
		Token savings compares tokens used without the skill and with it, same phone and same prompt. <a href="/skills/scoring/">How scoring works.</a>
	</p>
</HubLayout>

<script>
	import { nextSort, ariaSort, compareRows, type SortKey, type SortState, type SortRow } from '../../lib/hub/table-sort';
	type PF = { search: (q: string, o?: object) => Promise<{ results: { data: () => Promise<{ url: string }> }[] }>; init?: () => Promise<void> };
	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const q = $<HTMLInputElement>('q');
	const fTier = $<HTMLSelectElement>('f-tier');
	const fTrust = $<HTMLSelectElement>('f-trust');
	const fClass = $<HTMLSelectElement>('f-class');
	const fBlocked = document.getElementById('f-blocked') as HTMLInputElement | null;
	const fReference = document.getElementById('f-reference') as HTMLInputElement | null;
	const list = $<HTMLElement>('rows');
	const rows = [...list.querySelectorAll<HTMLTableRowElement>('tr.row')];
	let sort: SortState = { key: null, dir: 'desc' };
	let pagefind: PF | null | undefined;
	let hits: Set<string> | null = null;   // URLs matched by full-text search, null = no query

	async function loadPagefind(): Promise<PF | null> {
		if (pagefind !== undefined) return pagefind;
		try {
			const path = '/pagefind/pagefind.js';
			pagefind = (await import(/* @vite-ignore */ path)) as PF;
			await pagefind.init?.();
		} catch {
			pagefind = null; // dev server or index missing: substring match only
		}
		return pagefind;
	}

	async function search() {
		const text = q.value.trim().toLowerCase();
		if (!text) { hits = null; return apply(); }
		const pf = await loadPagefind();
		const local = new Set(rows.filter((r) => text.split(/\s+/).every((w) => r.dataset.text!.includes(w))).map((r) => r.dataset.url!));
		if (pf) {
			const res = await pf.search(text, { filters: { kind: 'skill' } });
			const data = await Promise.all(res.results.slice(0, 50).map((r) => r.data()));
			for (const d of data) local.add(new URL(d.url, location.origin).pathname);
		}
		if (q.value.trim().toLowerCase() !== text) return; // a newer query is in flight
		hits = local;
		apply();
	}

	function apply() {
		const minTier = Number(fTier.value);
		let shown = 0;
		for (const r of rows) {
			const ok = (hits == null || hits.has(r.dataset.url!))
				&& Number(r.dataset.tier) >= minTier
				&& (!fTrust.value || r.dataset.trust === fTrust.value)
				&& (!fClass.value || r.dataset.class === fClass.value)
				&& (r.dataset.blocked !== '1' || !!fBlocked?.checked)
				&& (r.dataset.reference !== '1' || !!fReference?.checked);
			r.hidden = !ok;
			if (ok) shown++;
		}
		const rowKey = (r: HTMLElement): SortRow => ({ name: r.dataset.name!, order: Number(r.dataset.order), actions: Number(r.dataset.actions), score: Number(r.dataset.score), runs: Number(r.dataset.runs), savings: Number(r.dataset.savings) });
		const sorted = [...rows].sort((a, b) => compareRows(sort, rowKey(a), rowKey(b)));
		list.append(...sorted);
		let position = 0;
		for (const r of sorted) r.querySelector<HTMLElement>('[data-rank]')!.textContent = r.hidden ? '' : String(++position);
		$('count').textContent = `${shown} ${shown === 1 ? 'skill' : 'skills'}`;
		$('empty').hidden = shown > 0;
	}

	for (const btn of document.querySelectorAll<HTMLButtonElement>('th button[data-sort]')) {
		btn.addEventListener('click', () => {
			sort = nextSort(sort, btn.dataset.sort as SortKey);
			for (const b of document.querySelectorAll<HTMLButtonElement>('th button[data-sort]')) {
				b.closest('th')!.setAttribute('aria-sort', ariaSort(sort, b.dataset.sort as SortKey));
			}
			apply();
		});
	}

	let t: number | undefined;
	q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(search, 150); });
	[fTier, fTrust, fClass, fBlocked, fReference].forEach((el) => el?.addEventListener('change', apply));
	const params = new URLSearchParams(location.search);
	if (params.get('reference') === '1' && fReference) { fReference.checked = true; apply(); }
	const initial = params.get('q');
	if (initial) { q.value = initial; search(); }
</script>
